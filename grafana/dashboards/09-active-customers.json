    {
      "id": 8,
      "type": "timeseries",
      "title": "Daily active users (by last_login day)",
      "description": "Count of users with last_login on each calendar day.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 9,
