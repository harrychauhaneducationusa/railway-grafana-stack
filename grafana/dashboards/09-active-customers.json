      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT id, email, created_at, last_login, subscription_status, subscription_type, plan_tier, is_verified\n       FROM users\n       WHERE deleted_at IS NULL\n       ORDER BY created_at DESC\n       LIMIT 100",
          "refId": "A"
        }
      ]
