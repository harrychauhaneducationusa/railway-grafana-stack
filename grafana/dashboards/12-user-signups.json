    {
      "id": 7,
      "type": "table",
      "title": "Weekly cohort: signups vs active in week+1",
      "description": "signup_week cohort; active_w1 = users with last_login in the 7 days after their signup week ended.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH base AS (\n         SELECT id,\n                date_trunc('week', created_at) AS signup_week,\n                created_at,\n                last_login\n         FROM users\n         WHERE deleted_at IS NULL\n           AND created_at >= NOW() - INTERVAL '365 days'\n       )\n       SELECT signup_week::date AS cohort_week,\n              COUNT(*) AS signups,\n              COUNT(*) FILTER (\n                WHERE last_login IS NOT NULL\n                  AND last_login >= signup_week + INTERVAL '7 days'\n                  AND last_login < signup_week + INTERVAL '14 days'\n              ) AS active_week_after_signup\n       FROM base\n       GROUP BY signup_week\n       ORDER BY signup_week DESC\n       LIMIT 26",
          "refId": "A"
        }
      ]
    }
  ]
}