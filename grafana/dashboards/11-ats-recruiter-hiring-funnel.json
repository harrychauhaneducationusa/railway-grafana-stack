    {
      "id": 19,
      "type": "stat",
      "title": "Guests who later signed up",
      "description": "Match **lower(users.email) = lower(candidate_email)**; user **created_at** after application **created_at**.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
