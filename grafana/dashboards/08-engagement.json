{
  "annotations": {
    "list": []
  },
  "description": "Referral lifecycle from **referrals** (Postgres). XP / learning panels remain TestData until instrumented in SQL. Reward constants: REFERRER_XP=200, REFERRED_XP=100, REFERRER_BONUS_REQUESTS=2, REFERRED_PREMIUM_DAYS (document in product).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "meta": {
    "folderName": "MockCoach"
  },
  "refresh": "5m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "mockcoach",
    "business",
    "postgres"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Engagement & Gamification",
  "uid": "mockcoach-engagement",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Referral rewards (product constants)",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "| Constant | Value |\n|----------|-------|\n| REFERRER_XP | 200 |\n| REFERRED_XP | 100 |\n| REFERRER_BONUS_REQUESTS | 2 |\n| REFERRED_PREMIUM_DAYS | (set in app config) |\n\nStatuses in DB: pending, signed_up, verified, activated, rewarded, completed, expired."
      }
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Referral lifecycle funnel (counts in range)",
      "description": "Ordered statuses from referrals.status.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT status AS metric, COUNT(*)::float AS value\n       FROM public.referrals\n       WHERE $__timeFilter(created_at)\n       GROUP BY status",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Referral conversion % (rewarded / pending baseline)",
      "description": "rewarded / NULLIF(all referrals in range,0). Adjust definition as needed.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "green",
                "value": 15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE status = 'rewarded') / NULLIF(COUNT(*), 0), 2)::numeric AS value\n       FROM public.referrals\n       WHERE $__timeFilter(created_at)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Expired referrals (range)",
      "description": "status = expired within $__timeFilter(created_at).",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::numeric AS value\n       FROM public.referrals\n       WHERE $__timeFilter(created_at)\n         AND status = 'expired'",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Top referrers",
      "description": "By count of referrals created in range.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "referral_count",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT referrer_id::text, COUNT(*) AS referral_count\n       FROM public.referrals\n       WHERE $__timeFilter(created_at)\n       GROUP BY referrer_id\n       ORDER BY referral_count DESC\n       LIMIT 30",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Referrals per day",
      "description": "Time series volume.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineWidth": 1,
              "showPoints": "never",
              "stacking": {
                "mode": "none",
                "group": "A"
              }
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', created_at)::timestamp AS time,\n              COUNT(*)::double precision AS value\n       FROM public.referrals\n       WHERE $__timeFilter(created_at)\n       GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },
