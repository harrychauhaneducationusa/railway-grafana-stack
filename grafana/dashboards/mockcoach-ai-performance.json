      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job=\"mockcoach-ai-staging\"}[5m])) by (le))",
          "legendFormat": "p50 (staging)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket{job=\"mockcoach-ai-staging\"}[5m])) by (le))",
          "legendFormat": "p90 (staging)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"mockcoach-ai-staging\"}[5m])) by (le))",
          "legendFormat": "p99 (staging)",
          "refId": "C"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
