        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(mockcoach_worker_job_duration_seconds_bucket{job=\"mockcoach-worker-prod\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.90, sum(rate(mockcoach_worker_job_duration_seconds_bucket{job=\"mockcoach-worker-prod\"}[5m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(mockcoach_worker_job_duration_seconds_bucket{job=\"mockcoach-worker-prod\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
