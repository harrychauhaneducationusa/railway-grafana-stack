      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 7 },
      "id": 8,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "title": "Job Throughput (completed / failed / retried)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "sum(rate(mockcoach_worker_jobs_total{job=\"mockcoach-worker-prod\",status=\"completed\"}[2m]))",
          "legendFormat": "completed",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "sum(rate(mockcoach_worker_jobs_total{job=\"mockcoach-worker-prod\",status=\"failed\"}[2m]))",
          "legendFormat": "failed",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "sum(rate(mockcoach_worker_jobs_total{job=\"mockcoach-worker-prod\",status=\"retried\"}[2m]))",
          "legendFormat": "retried",
          "refId": "C"
        }
      ]
    },
