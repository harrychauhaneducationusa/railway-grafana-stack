          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "mockcoach_db_pool_active{job=\"mockcoach-ai-prod\"}",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
