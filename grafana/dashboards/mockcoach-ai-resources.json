          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "title": "CPU Usage — Staging",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "100 * (rate(mockcoach_process_cpu_user_seconds_total{job=\"mockcoach-ai-staging\"}[2m]) + rate(mockcoach_process_cpu_system_seconds_total{job=\"mockcoach-ai-staging\"}[2m]))",
          "legendFormat": "cpu % (staging)",
          "refId": "A"
        }
      ]
