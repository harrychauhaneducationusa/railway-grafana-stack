    {
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "description": "Heatmap of job processing duration distribution. Helps identify bimodal distributions or outliers.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "scheme" },
          "custom": { "fillOpacity": 80, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineWidth": 1, "scaleDistribution": { "type": "linear" } },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
