  "title": "Active Customers & Platform Health",
  "uid": "mockcoach-active-customers",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Notes",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**subscriptions** uses `status`, `plan_id`, `created_at`. **users** uses `subscription_status`, `plan_tier`, `subscription_type`, `last_login`, `created_at`. **company_subscriptions** uses `plan_type`, `status`. Tune joins if your deployment uses `user_subscriptions` / `subscriptions_v2` instead."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active users (last login ≤ 30d)",
      "description": "Users not deleted with last_login in the last 30 days.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::numeric AS value\n       FROM users\n       WHERE deleted_at IS NULL\n         AND last_login IS NOT NULL\n         AND last_login >= NOW() - INTERVAL '30 days'",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Users with active subscription row",
      "description": "Count of users joined to subscriptions with status active (legacy subscriptions table).",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT u.id)::numeric AS value\n       FROM users u\n       INNER JOIN subscriptions s ON s.user_id = u.id\n       WHERE u.deleted_at IS NULL\n         AND LOWER(s.status) = 'active'",
          "refId": "A"
        }
      ]
    },
