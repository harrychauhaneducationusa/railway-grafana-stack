      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::numeric AS value\n       FROM public.job_applications ja\n       JOIN public.users u ON lower(u.email) = lower(ja.candidate_email)\n       WHERE ja.candidate_id IS NULL\n         AND u.created_at > ja.created_at\n         AND $__timeFilter(ja.created_at)",
          "refId": "A"
        }
      ]
