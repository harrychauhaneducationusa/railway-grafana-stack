      "title": "Log Volume by Level — Production",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "grafana_lokiq" },
          "expr": "sum(count_over_time({app=\"mockcoach-ai\", env=\"production\", level=\"error\"}[1m]))",
          "legendFormat": "error",
          "refId": "A"
