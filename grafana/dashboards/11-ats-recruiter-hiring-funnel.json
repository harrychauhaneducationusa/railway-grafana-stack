    {
      "id": 26,
      "type": "barchart",
      "title": "AI screening score (final_score) distribution",
      "description": "Histogram buckets; null scores excluded.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 56
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "showValue": "auto",
        "stacking": "none",
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT metric, value\n       FROM (\n         SELECT\n           CASE\n             WHEN final_score < 20 THEN '0–19'\n             WHEN final_score < 40 THEN '20–39'\n             WHEN final_score < 60 THEN '40–59'\n             WHEN final_score < 80 THEN '60–79'\n             ELSE '80–100'\n           END AS metric,\n           COUNT(*)::float AS value,\n           MIN(\n             CASE\n               WHEN final_score < 20 THEN 1\n               WHEN final_score < 40 THEN 2\n               WHEN final_score < 60 THEN 3\n               WHEN final_score < 80 THEN 4\n               ELSE 5\n             END\n           ) AS ord\n         FROM public.job_applications\n         WHERE $__timeFilter(created_at) AND final_score IS NOT NULL\n         GROUP BY CASE\n           WHEN final_score < 20 THEN '0–19'\n           WHEN final_score < 40 THEN '20–39'\n           WHEN final_score < 60 THEN '40–59'\n           WHEN final_score < 80 THEN '60–79'\n           ELSE '80–100'\n         END\n       ) buckets\n       ORDER BY ord",
          "refId": "A"
        }
      ]
    },
