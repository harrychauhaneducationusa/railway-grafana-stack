    {
      "id": 5,
      "type": "barchart",
      "title": "Email volume by notification type (top 10)",
      "description": "channel in (email, both).",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT type AS metric, COUNT(*)::float AS value\n       FROM public.notifications\n       WHERE $__timeFilter(created_at)\n         AND channel IN ('email', 'both')\n       GROUP BY type\n       ORDER BY value DESC\n       LIMIT 10",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Daily email notification volume",
      "description": "channel email or both.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineWidth": 1,
              "showPoints": "never",
              "stacking": {
                "mode": "none",
                "group": "A"
              }
            },
            "drawStyle": "bars",
            "fillOpacity": 25
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', created_at)::timestamp AS time,\n              COUNT(*)::double precision AS value\n       FROM public.notifications\n       WHERE $__timeFilter(created_at)\n         AND channel IN ('email', 'both')\n       GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "ATS / apply-related emails (heuristic)",
      "description": "Filters type/title/body for ats, apply, job. Tune patterns for your notification type strings.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "fillOpacity": 10,
              "lineWidth": 1,
              "showPoints": "never",
              "stacking": {
                "mode": "none",
                "group": "A"
              }
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', created_at)::timestamp AS time,\n              COUNT(*)::double precision AS value\n       FROM public.notifications\n       WHERE $__timeFilter(created_at)\n         AND channel IN ('email', 'both')\n         AND (\n           LOWER(type) LIKE '%ats%'\n           OR LOWER(title) LIKE '%apply%'\n           OR LOWER(title) LIKE '%application%'\n           OR LOWER(body) LIKE '%apply%'\n         )\n       GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Worker jobs email-sending (rate by status)",
      "description": "rate(mockcoach_worker_jobs_total{job_type=\"email-sending\"}[5m]) — adjust job_type label if your worker uses a different job_type string.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafana_prometheus"
      },
