  "description": "Background job queue metrics for mockcoach-worker-prod: queue depth, throughput, processing time, success/failure rates, and worker logs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": ["mockcoach-ai"],
      "targetBlank": false,
      "title": "mockcoach-ai Dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
