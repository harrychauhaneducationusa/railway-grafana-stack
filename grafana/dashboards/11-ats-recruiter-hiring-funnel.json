    {
      "id": 8,
      "type": "table",
      "title": "Top 10 recruiters (by jobs in range)",
      "description": "Join **users** for name and email; counts from **job_postings** in time range.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "jobs_posted",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n         u.id::text AS user_id,\n         COALESCE(NULLIF(TRIM(CONCAT(COALESCE(u.first_name, ''), ' ', COALESCE(u.last_name, ''))), ''), u.email) AS display_name,\n         u.email,\n         cp.name AS company_name,\n         COUNT(jp.id)::int AS jobs_posted,\n         SUM(COALESCE(jp.applications_count, 0))::bigint AS applications_on_jobs\n       FROM public.job_postings jp\n       JOIN public.users u ON u.id = jp.posted_by\n       LEFT JOIN public.company_profiles cp ON cp.id = jp.company_id\n       WHERE $__timeFilter(jp.created_at)\n       GROUP BY u.id, u.email, u.first_name, u.last_name, cp.name\n       ORDER BY jobs_posted DESC\n       LIMIT 10",
          "refId": "A"
        }
      ]
    },
