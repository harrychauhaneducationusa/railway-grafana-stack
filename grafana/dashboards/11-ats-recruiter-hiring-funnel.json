    {
      "id": 20,
      "type": "gauge",
      "title": "Platform signup conversion from guest apply %",
      "description": "Guests who later signed up ÷ total guest applications in range × 100.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              },
              {
                "color": "green",
                "value": 0.5
              },
              {
                "color": "yellow",
                "value": 5
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH g AS (\n         SELECT COUNT(*)::numeric AS guest_total\n         FROM public.job_applications\n         WHERE $__timeFilter(created_at) AND candidate_id IS NULL\n       ),\n       c AS (\n         SELECT COUNT(*)::numeric AS converted\n         FROM public.job_applications ja\n         JOIN public.users u ON lower(u.email) = lower(ja.candidate_email)\n         WHERE ja.candidate_id IS NULL\n           AND u.created_at > ja.created_at\n           AND $__timeFilter(ja.created_at)\n       )\n       SELECT ROUND(100.0 * c.converted / NULLIF(g.guest_total, 0), 2)::numeric AS value FROM g, c",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Avg hours: application → signup",
      "description": "Among guest rows that later matched a user with **users.created_at > ja.created_at**.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(AVG(EXTRACT(EPOCH FROM (u.created_at::timestamptz - ja.created_at)) / 3600.0)::numeric, 2) AS value\n       FROM public.job_applications ja\n       JOIN public.users u ON lower(u.email) = lower(ja.candidate_email)\n       WHERE ja.candidate_id IS NULL\n         AND u.created_at > ja.created_at\n         AND $__timeFilter(ja.created_at)",
          "refId": "A"
        }
      ]
    },
