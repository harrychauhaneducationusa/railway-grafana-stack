{
  "annotations": {
    "list": []
  },
  "description": "BullMQ worker health. Histogram uses **job_type** label (queue-aligned names). **Folder:** MockCoach.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "meta": {
    "folderName": "MockCoach"
  },
  "panels": [
    {
      "id": 1,
      "title": "Queue Depth per Queue",
      "description": "mockcoach_worker_queue_depth — waiting + delayed jobs per BullMQ queue.",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "grafana_prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mockcoach_worker_queue_depth{job=~\"$service\"}",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Active Jobs per Queue",
      "description": "mockcoach_worker_jobs_active — one bar per queue (same shape as queue depth).",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "grafana_prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mockcoach_worker_jobs_active{job=~\"$service\"}",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Job Throughput (completed/s)",
      "description": "rate(mockcoach_worker_jobs_total{status=\"completed\"}[5m]) summed across job_type.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafana_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job_type) (rate(mockcoach_worker_jobs_total{job=~\"$service\",status=\"completed\"}[5m]))",
          "legendFormat": "{{job_type}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Job Failure Rate %",
      "description": "failed job rate / all job outcomes (completed+failed+retried). Red gauge when ≥5%.",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "grafana_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(mockcoach_worker_jobs_total{job=~\"$service\",status=\"failed\"}[5m])) / clamp_min(sum(rate(mockcoach_worker_jobs_total{job=~\"$service\"}[5m])), 1e-9)"
        }
      ]
    },
    {
      "id": 5,
      "title": "Failed Jobs Pending Retry",
      "description": "mockcoach_worker_jobs_failed gauge per queue (BullMQ failed count).",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "grafana_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mockcoach_worker_jobs_failed{job=~\"$service\"}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Job Duration P95 by job_type",
      "description": "mockcoach_worker_job_duration_seconds — histogram quantile 0.95 by job_type (queue-aligned).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafana_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, job_type) (rate(mockcoach_worker_job_duration_seconds_bucket{job=~\"$service\"}[5m])))",
          "legendFormat": "{{job_type}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Jobs Total by Status (rate)",
      "description": "Stacked rates for completed, failed, retried from mockcoach_worker_jobs_total.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "grafana_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 25,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mockcoach_worker_jobs_total{job=~\"$service\",status=\"completed\"}[5m]))",
          "legendFormat": "completed"
        },
        {
          "refId": "B",
          "expr": "sum(rate(mockcoach_worker_jobs_total{job=~\"$service\",status=\"failed\"}[5m]))",
          "legendFormat": "failed"
        },
        {
          "refId": "C",
          "expr": "sum(rate(mockcoach_worker_jobs_total{job=~\"$service\",status=\"retried\"}[5m]))",
          "legendFormat": "retried"
        }
      ]
    }
  ],
