      "title": "Worker jobs email-sending (fallback: any job_type matching email)",
      "description": "If job_type label differs, use this broader regex.",
      "datasource": {
        "type": "prometheus",
        "uid": "grafana_prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
