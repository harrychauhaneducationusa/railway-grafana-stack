    {
      "id": 2,
      "type": "barchart",
      "title": "Applications: guest vs registered (schema-aware)",
      "description": "If candidate_id becomes nullable, guest rows appear in guest_count.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n         CASE WHEN candidate_id IS NULL THEN 'guest' ELSE 'registered' END AS metric,\n         COUNT(*)::float AS value\n       FROM job_applications\n       WHERE $__timeFilter(created_at)\n       GROUP BY 1",
          "refId": "A"
        }
      ]
    },
