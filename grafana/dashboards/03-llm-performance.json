      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le, model) (rate(llm_request_duration_seconds_bucket{job=~\"mockcoach.*\"}[5m])))",
          "legendFormat": "p50 {{model}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(llm_request_duration_seconds_bucket{job=~\"mockcoach.*\"}[5m])))",
          "legendFormat": "p95 {{model}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, model) (rate(llm_request_duration_seconds_bucket{job=~\"mockcoach.*\"}[5m])))",
          "legendFormat": "p99 {{model}}"
        }
      ]
    },
