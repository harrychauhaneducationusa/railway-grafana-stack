    {
      "id": 6,
      "type": "table",
      "title": "Top jobs by application volume",
      "description": "Join to job_postings title.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT jp.title, jp.id::text AS job_id, COUNT(ja.id) AS applications\n       FROM job_applications ja\n       JOIN job_postings jp ON jp.id = ja.job_id\n       WHERE $__timeFilter(ja.created_at)\n       GROUP BY jp.id, jp.title\n       ORDER BY applications DESC\n       LIMIT 25",
          "refId": "A"
        }
      ]
    }
