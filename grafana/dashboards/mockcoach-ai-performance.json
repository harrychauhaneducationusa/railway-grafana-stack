      "title": "Redis Cache Operations — Production",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "rate(mockcoach_redis_hits_total{job=\"mockcoach-ai-prod\"}[2m])",
          "legendFormat": "hits",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "rate(mockcoach_redis_misses_total{job=\"mockcoach-ai-prod\"}[2m])",
          "legendFormat": "misses",
          "refId": "B"
