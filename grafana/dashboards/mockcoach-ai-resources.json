        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "mockcoach_process_resident_memory_bytes{job=\"mockcoach-ai\"}",
          "legendFormat": "RSS (prod)",
          "refId": "C"
        }
      ]
    },
