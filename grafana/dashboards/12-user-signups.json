      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', created_at)::timestamp AS time,\n              COUNT(*)::double precision AS value\n       FROM users\n       WHERE deleted_at IS NULL AND $__timeFilter(created_at)\n       GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },
