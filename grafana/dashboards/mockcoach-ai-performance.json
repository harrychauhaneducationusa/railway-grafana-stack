        "legend": { "show": true },
        "rowsFrame": { "layout": "auto" },
        "tooltip": { "mode": "single", "showColorScale": false, "yHistogram": false },
        "yAxis": { "axisPlacement": "left", "reverse": false, "unit": "s" }
      },
      "title": "Request Duration Heatmap — Production",
      "type": "heatmap",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "sum(rate(http_request_duration_seconds_bucket{job=\"mockcoach-ai-prod\"}[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "description": "Heatmap of HTTP request duration distribution for staging.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "scheme" },
          "custom": { "fillOpacity": 80, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineWidth": 1, "scaleDistribution": { "type": "linear" } },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "exponent": 0.5, "fill": "dark-blue", "mode": "scheme", "reverse": false, "scale": "exponential", "scheme": "Blues", "steps": 64 },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "filterValues": { "le": 1e-9 },
        "legend": { "show": true },
        "rowsFrame": { "layout": "auto" },
        "tooltip": { "mode": "single", "showColorScale": false, "yHistogram": false },
        "yAxis": { "axisPlacement": "left", "reverse": false, "unit": "s" }
      },
      "title": "Request Duration Heatmap — Staging",
      "type": "heatmap",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "sum(rate(http_request_duration_seconds_bucket{job=\"mockcoach-ai-staging\"}[5m])) by (le)",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 101,
      "title": "🚦 Throughput & Error Rates",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "description": "Total HTTP request throughput (all status codes) for both environments.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "req/s", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 5,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "title": "Total Request Throughput",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "sum(rate(http_requests_total{job=\"mockcoach-ai-prod\"}[2m]))",
          "legendFormat": "prod",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "sum(rate(http_requests_total{job=\"mockcoach-ai-staging\"}[2m]))",
          "legendFormat": "staging",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "description": "5xx error rate as a percentage of total requests for both environments.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "error %", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 20, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "line+area" } },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] },
          "unit": "percent",
          "min": 0
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "prod 5xx %" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "staging 5xx %" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 6,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "title": "5xx Error Rate",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "100 * sum(rate(http_requests_total{job=\"mockcoach-ai-prod\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"mockcoach-ai-prod\"}[5m]))",
          "legendFormat": "prod 5xx %",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "100 * sum(rate(http_requests_total{job=\"mockcoach-ai-staging\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"mockcoach-ai-staging\"}[5m]))",
          "legendFormat": "staging 5xx %",
          "refId": "B"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "id": 102,
      "title": "🗺 Per-Route Breakdown",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "description": "Top routes by request rate in production. Helps identify hot paths and unexpected traffic spikes.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "req/s" },
            "properties": [
              { "id": "custom.width", "value": 120 },
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge" } },
              { "id": "color", "value": { "mode": "continuous-BlPu" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 29 },
      "id": 7,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true, "sortBy": [{ "desc": true, "displayName": "req/s" }] },
      "title": "Top Routes by Request Rate — Production",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "topk(15, sum(rate(http_requests_total{job=\"mockcoach-ai-prod\"}[5m])) by (route))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "req/s", "route": "Route" } } }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
      "description": "Top routes by p99 latency in production. Helps identify slow endpoints.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 1 }] },
          "unit": "s"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p99 latency" },
            "properties": [
              { "id": "custom.width", "value": 140 },
