  "title": "Email & Notification Delivery",
  "uid": "mockcoach-email-notifications",
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total email-capable notifications (range)",
      "description": "channel in (email, both), time filtered.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*)::numeric AS value\n       FROM public.notifications\n       WHERE $__timeFilter(created_at)\n         AND channel IN ('email', 'both')",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Unread rate % (range)",
      "description": "Among rows in time range.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "red",
                "value": 40
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE NOT is_read) / NULLIF(COUNT(*),0), 2)::numeric AS value\n       FROM public.notifications\n       WHERE $__timeFilter(created_at)",
          "refId": "A"
        }
      ]
    },
