    {
      "id": 14,
      "type": "barchart",
      "title": "Application_state funnel (ordered)",
      "description": "Counts by **application_state** enum in funnel order.",
      "datasource": {
        "type": "postgres",
        "uid": "grafana_mockcoach_pg"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT application_state::text AS metric,\n              COUNT(*)::float AS value\n       FROM public.job_applications\n       WHERE $__timeFilter(created_at)\n       GROUP BY application_state\n       ORDER BY CASE application_state::text\n         WHEN 'DRAFT' THEN 1\n         WHEN 'PENDING_VERIFICATION' THEN 2\n         WHEN 'VERIFIED' THEN 3\n         WHEN 'SUBMITTED' THEN 4\n         WHEN 'SCORING_PENDING' THEN 5\n         WHEN 'SCORED' THEN 6\n         WHEN 'INTERVIEW_PENDING' THEN 7\n         WHEN 'INTERVIEWED' THEN 8\n         WHEN 'DECISION_MADE' THEN 9\n         ELSE 99\n       END",
          "refId": "A"
        }
      ]
    },
