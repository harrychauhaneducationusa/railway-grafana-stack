            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 29 },
      "id": 8,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true, "sortBy": [{ "desc": true, "displayName": "p99 latency" }] },
      "title": "Slowest Routes (p99) — Production",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "grafana_prometheus" },
          "expr": "topk(15, histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job=\"mockcoach-ai-prod\"}[5m])) by (le, route)))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "le": true }, "renameByName": { "Value": "p99 latency", "route": "Route" } } }
      ]
    },
