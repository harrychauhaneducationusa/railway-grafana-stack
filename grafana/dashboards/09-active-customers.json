          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "grafana_mockcoach_pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(plan_tier, 'unknown') AS metric, COUNT(*)::float AS value\n       FROM users\n       WHERE deleted_at IS NULL\n       GROUP BY plan_tier",
