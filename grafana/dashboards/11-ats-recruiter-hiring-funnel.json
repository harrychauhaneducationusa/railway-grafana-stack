          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT LEAST(100, ROUND(100.0 * SUM(COALESCE(applications_count, 0)) / NULLIF(SUM(COALESCE(views_count, 0)), 0), 2))::numeric AS value\n       FROM public.job_postings",
          "refId": "A"
        }
