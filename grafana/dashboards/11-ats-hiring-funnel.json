          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT status AS metric, COUNT(*)::float AS value\n       FROM job_applications\n       WHERE $__timeFilter(created_at)\n       GROUP BY status\n       ORDER BY value DESC",
