      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "grafana_prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (status, job_type) (rate(mockcoach_worker_jobs_total{job_type=~\".*email.*\"}[5m]))",
